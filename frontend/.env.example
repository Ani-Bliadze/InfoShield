# Frontend build-time config. Copy to .env.production (or set these in your
# Vercel/Netlify project settings) for the HOSTED deploy. Leave both UNSET for
# local development so the real extension drives the overlays as before.

# Turn on hosted mode: the site renders the InfoShield overlays itself and
# pre-activates, so a single link is testable without installing the extension.
VITE_HOSTED=1

# The deployed backend (your Hugging Face Space's direct URL).
VITE_API_BASE=https://<your-user>-<your-space>.hf.space
