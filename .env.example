# Copy this file to ".env" and fill in your key. Never commit ".env".

# LLM provider for the analysis (explainer): "gemini" (default) or "groq".
INFOSHIELD_LLM_PROVIDER=gemini

# Second-pass verifier (LLM-as-judge). Runs on the stronger Gemini Pro model;
# analysis runs on Flash (GEMINI_MODEL in config.py = gemini-3.5-flash).
# INFOSHIELD_VERIFIER_PROVIDER=gemini
# INFOSHIELD_VERIFIER_MODEL=gemini-3.1-pro-preview

# Groq API key (https://console.groq.com/keys) -- used when provider=groq.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API key (https://aistudio.google.com/apikey) -- used when provider=gemini.
GEMINI_API_KEY=

# Optional overrides
# INFOSHIELD_MANIP_THRESHOLD=0.50   # manipulation flag cutoff (precision-first default)
# INFOSHIELD_RESET_ACTIVATION=1     # reset activation on each backend start (fresh demo)
# INFOSHIELD_HOST=127.0.0.1
# INFOSHIELD_PORT=5050
# INFOSHIELD_FRONTEND=http://localhost:5173
