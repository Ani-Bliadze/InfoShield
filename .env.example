# Copy this file to ".env" and fill in your key. Never commit ".env".

# Google Gemini API key (https://aistudio.google.com/apikey)
# Required only to REBUILD analyses with build_cache.py / use /analyze live.
# The cache-first demo runs fine without it.
GEMINI_API_KEY=

# Optional overrides
# INFOSHIELD_HOST=127.0.0.1
# INFOSHIELD_PORT=5050
# INFOSHIELD_FRONTEND=http://localhost:5173
